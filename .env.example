# Server only. Empty credentials select illustrative, offline samples.
QLOO_API_KEY=
QLOO_ORIGIN=
QLOO_MODE=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
MIXTAPE_AGENT_MODE=

# Public hosting: canonical HTTPS origin, stable random secret, verified ingress.
APP_ORIGIN=
SESSION_SECRET=
PUBLIC_DEMO=
INGRESS_VERIFIED=
TRUST_PROXY_IP=

# Supplied by ShipTiffin. Durable state uses Valkey; no Postgres schema is needed.
DATABASE_URL=
REDIS_URL=
VALKEY_PREFIX=
TIFFIN_URL=
TIFFIN_PROJECT=
REQUIRE_REDIS=

# Confirm actual Qloo access, expiry and a non-overlapping credential allocation.
QLOO_EVENT_ACCESS_CONFIRMED=
QLOO_ACCESS_EXPIRES_AT=
QLOO_ALLOCATION_CONFIRMED=
QLOO_DAILY_ATTEMPTS=
QLOO_TOTAL_ATTEMPTS=

# Optional budget overrides and explicit custom-model cost policy.
MODEL_DAILY_CAP_USD=
MODEL_TOTAL_CAP_USD=
MODEL_COST_BOUND_CONFIRMED=
MODEL_POLICY_MODEL=
MODEL_BYTE_TOKEN_BOUND_CONFIRMED=
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
PAUSE_GENERATION=

# Local tools only. Leave the development cache unset in production.
QLOO_DEV_CACHE_DIR=
QLOO_SAMPLE_DIR=
QLOO_REVIEWED_INPUT=
MIXTAPE_PREPARE_LIVE=
MIXTAPE_INSTALL_LIVE=
MIXTAPE_LIVE_AGENT=
MIXTAPE_SHOTS_DIR=
MIXTAPE_KV_PRESSURE_TEST=

# Runtime-managed; omit unless deliberately overriding the server environment.
NODE_ENV=
PORT=
